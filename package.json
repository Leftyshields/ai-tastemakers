{
  "name": "ai-tastemakers",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "node --test lib/loadGenome.test.js lib/decompose.test.js lib/signaling.test.js lib/guardrails.test.js lib/run.test.js lib/repair.test.js scripts/derive-expression-profiles.test.js scripts/molecules-read_file.test.js",
    "test:instantiate": "node --test scripts/instantiate.test.js",
    "test:digest": "vitest run",
    "digest": "tsx src/tastemaker/cli.ts",
    "digest:resend-email": "tsx src/tastemaker/resend-email-cli.ts",
    "weekly": "tsx src/tastemaker/weekly-cli.ts",
    "monthly": "tsx src/tastemaker/monthly-cli.ts",
    "build:digest": "tsc -p tsconfig.json",
    "build:pages": "tsx scripts/build-pages.ts && tailwindcss -i site/assets/input.css -o site/assets/style.css --minify && tsx scripts/stamp-css-cache-bust.ts",
    "inventory:tools": "tsx src/tastemaker/inventory-cli.ts",
    "experiment": "tsx src/tastemaker/experiments-cli.ts",
    "experiment:reminders": "tsx src/tastemaker/experiment-reminders-cli.ts",
    "lab:validate-experiments": "tsx scripts/lab/validate-experiments.ts",
    "lab:sync-posthog-status": "tsx scripts/lab/sync-posthog-experiment-status.ts",
    "genesis:run": "node scripts/genesis-run.js",
    "genesis:verify-experiments-page": "bash genesis/verify-experiments-page.sh",
    "render:digest-email": "tsx scripts/render-digest-email-preview.ts",
    "verify:genesis": "sh scripts/verify-genesis.sh",
    "verify:digest": "node scripts/verify-daily-digest.mjs",
    "subscribers:add": "tsx scripts/add-subscriber.ts",
    "subscribers:remove": "tsx scripts/remove-subscriber.ts",
    "subscribers:seed-firestore": "tsx scripts/seed-subscribers-firestore.ts",
    "subscribers:migrate-unsubscribe-tokens": "tsx scripts/migrate-subscriber-unsubscribe-tokens.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "dotenv": "^16.4.7",
    "firebase-admin": "^13.4.0",
    "resend": "^6.12.4"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "jsdom": "24.1.3",
    "marked": "^18.0.5",
    "playwright": "1.49.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "tsx": "4.22.4",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
